# Copy this file to .env and fill in your keys. .env is git-ignored, so keys never reach GitHub.

# Gemini (Google AI Studio → Get API key). Used to read wall photos and watch climbing clips.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backups, tried in order when the main model says it's overloaded (503 "high demand").
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Muse Spark (Meta Model API → dev.meta.ai → API keys). Used for coaching, crew recaps, and chat.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3

# Optional: the AI Mentor's MediaPipe pose service. It should accept POST multipart field "video"
# and return the observations JSON. Leave blank if it isn't running.
POSE_SERVICE_URL=

PORT=8787
